            ];
            
            // Event Listeners
            document.getElementById('startBtn').addEventListener('click', function() {
                showSection(2);
            });
            
            document.getElementById('findWinesBtn').addEventListener('click', function() {
                // Gather user selections
                userProfile.meal = document.querySelector('.quiz-question:nth-child(1) .quiz-option.selected')?.dataset.value || '';
                userProfile.flavor = document.querySelector('.quiz-question:nth-child(2) .quiz-option.selected')?.dataset.value || '';
                userProfile.sweetness = document.querySelector('.quiz-question:nth-child(3) .quiz-option.selected')?.dataset.value || '';
                userProfile.dietary = document.querySelector('.quiz-question:nth-child(4) .quiz-option.selected')?.dataset.value || '';
                userProfile.budget = document.querySelector('.quiz-question:nth-child(5) .quiz-option.selected')?.dataset.value || '';
                
                // Show processing section
                showSection(3);
                
                // Simulate AI processing
                simulateAIProcessing();
            });
            
            document.getElementById('saveRatingsBtn').addEventListener('click', function() {
                showSection(5);
                populateRatingHistory();
            });
            
            document.getElementById('startOverBtn').addEventListener('click', function() {
                resetQuiz();
                showSection(1);
            });
            
            // Add click event for quiz options
            document.querySelectorAll('.quiz-option').forEach(option => {
                option.addEventListener('click', function() {
                    // Remove selected class from siblings
                    const siblings = this.parentNode.querySelectorAll('.quiz-option');
                    siblings.forEach(sib => sib.classList.remove('selected'));
                    
                    // Add selected class to clicked option
                    this.classList.add('selected');
                });
            });
            
            // Functions
            function showSection(sectionNumber) {
                // Hide all sections
                sections.forEach(section => {
                    section.classList.remove('active');
                });
                
                // Show the selected section
                document.getElementById(`section${sectionNumber}`).classList.add('active');
                
                // Update progress bar
                const progress = (sectionNumber - 1) * 25;
                progressBar.style.width = `${progress}%`;
                
                // Update nav dots
                navDots.forEach(dot => {
                    dot.classList.remove('active');
                });
                document.querySelector(`.nav-dot[data-section="${sectionNumber}"]`).classList.add('active');
                
                // Scroll to top
                window.scrollTo(0, 0);
            }
            
            function simulateAIProcessing() {
                const statusItems = document.querySelectorAll('#aiStatusUpdates div');
                let currentItem = 2; // Start at the third item (index 2)
                
                const interval = setInterval(() => {
                    if (currentItem < statusItems.length) {
                        // Update current item to "in progress"
                        statusItems[currentItem].querySelector('i').classList.remove('fa-circle');
                        statusItems[currentItem].querySelector('i').classList.add('fa-spinner', 'fa-spin', 'text-primary');
                        statusItems[currentItem].querySelector('p').classList.remove('text-gray-400');
                        
                        // Update previous item to "completed"
                        if (currentItem > 0) {
                            statusItems[currentItem - 1].querySelector('i').classList.remove('fa-spinner', 'fa-spin', 'text-primary');
                            statusItems[currentItem - 1].querySelector('i').classList.add('fa-check-circle', 'text-green-500');
                        }
                        
                        currentItem++;
                    } else {
                        // Update the last item to "completed"
                        statusItems[statusItems.length - 1].querySelector('i').classList.remove('fa-spinner', 'fa-spin', 'text-primary');
                        statusItems[statusItems.length - 1].querySelector('i').classList.add('fa-check-circle', 'text-green-500');
                        statusItems[statusItems.length - 1].querySelector('p').classList.remove('text-gray-400');
                        
                        clearInterval(interval);
                        
                        // After a short delay, show recommendations
                        setTimeout(() => {
                            generateWineRecommendations();
                            showSection(4);
                        }, 1000);
                    }
                }, 1000);
            }
            
            function generateWineRecommendations() {
                // Filter wines based on user profile
                let matchedWines = wineDatabase.filter(wine => {
                    // Create a score for each wine
                    let score = 0;
                    
                    // Check for meal match
                    if (wine.tags.includes(userProfile.meal)) score += 2;
                    
                    // Check for flavor match
                    if (wine.tags.includes(userProfile.flavor)) score += 2;
                    
                    // Check for sweetness match
                    if (wine.tags.includes(userProfile.sweetness)) score += 1;
                    
                    // Check for dietary match
                    if (userProfile.dietary !== 'none' && wine.tags.includes(userProfile.dietary)) score += 1;
                    
                    // Check for budget match
                    if (wine.tags.includes(userProfile.budget)) score += 1;
                    
                    return score >= 2; // At least some match
                });
                
                // If no matches, use some default recommendations
                if (matchedWines.length === 0) {
                    matchedWines = wineDatabase.slice(0, 4);
                }
                
                // Limit to top 4 recommendations
                matchedWines = matchedWines.slice(0, 4);
                
                // Generate HTML for wine recommendations
                const recommendationsContainer = document.getElementById('wineRecommendations');
                recommendationsContainer.innerHTML = '';
                
                matchedWines.forEach(wine => {
                    const wineTypeClass = `wine-${wine.type.toLowerCase()}`;
                    const wineCard = document.createElement('div');
                    wineCard.className = `wine-card ${wineTypeClass} p-6 rounded-lg shadow-md mb-6 relative`;
                    wineCard.innerHTML = `
                        <div class="flex flex-col md:flex-row">
                            <div class="md:w-3/4 pr-4">
                                <div class="flex justify-between items-start mb-3">
                                    <h3 class="text-2xl font-bold">${wine.name}</h3>
                                    <span class="text-sm font-semibold text-primary">${wine.price}</span>
                                </div>
                                <div class="mb-4">
                                    <span class="wine-badge mr-2">${wine.type}</span>
                                    <span class="wine-region text-sm">${wine.region}</span>
                                </div>
                                <p class="mb-4 text-gray-600">${wine.description}</p>
                                <div class="mb-4">
                                    <h4 class="font-semibold mb-1">Grapes:</h4>
                                    <p>${wine.grapes}</p>
                                </div>
                                <div>
                                    <h4 class="font-semibold mb-1">Perfect Pairings:</h4>
                                    <p>${wine.pairings}</p>
                                </div>
                            </div>
                            <div class="md:w-1/4 mt-4 md:mt-0">
                                <div class="bg-gray-100 rounded-lg p-4 h-full">
                                    <h4 class="font-semibold mb-3 text-center">Rate This Pairing</h4>
                                    <div class="flex justify-center space-x-2 mb-4">
                                        <div class="rating-stars flex" data-wine-id="${wine.id}">
                                            <i class="fas fa-star rating-star" data-rating="1"></i>
                                            <i class="fas fa-star rating-star" data-rating="2"></i>
                                            <i class="fas fa-star rating-star" data-rating="3"></i>
                                            <i class="fas fa-star rating-star" data-rating="4"></i>
                                            <i class="fas fa-star rating-star" data-rating="5"></i>
                                        </div>
                                    </div>
                                    <div class="flex justify-center space-x-4">
                                        <div class="feedback-btn" data-wine-id="${wine.id}" data-feedback="like">
                                            <i class="fas fa-thumbs-up text-xl"></i>
                                        </div>
                                        <div class="feedback-btn" data-wine-id="${wine.id}" data-feedback="dislike">
                                            <i class="fas fa-thumbs-down text-xl"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    
                    recommendationsContainer.appendChild(wineCard);
                });
                
                // Add event listeners for rating stars
                document.querySelectorAll('.rating-star').forEach(star => {
                    star.addEventListener('click', function() {
                        const ratingValue = parseInt(this.dataset.rating);
                        const wineId = parseInt(this.closest('.rating-stars').dataset.wineId);
                        const stars = this.closest('.rating-stars').querySelectorAll('.rating-star');
                        
                        // Reset all stars
                        stars.forEach(s => {
                            s.style.color = '#ccc';
                        });
                        
                        // Color stars up to selected rating
                        for (let i = 0; i < ratingValue; i++) {
                            stars[i].style.color = '#D4AF37';
                        }
                        
                        // Save rating
                        const wine = wineDatabase.find(w => w.id === wineId);
                        currentRatings.push({
                            id: wineId,
                            name: wine.name,
                            rating: ratingValue,
                            date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
                            notes: "Added from recommendations"
                        });
                    });
                });
                
                // Add event listeners for feedback buttons
                document.querySelectorAll('.feedback-btn').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const wineId = parseInt(this.dataset.wineId);
                        const feedback = this.dataset.feedback;
                        const feedbackBtns = document.querySelectorAll(`.feedback-btn[data-wine-id="${wineId}"]`);
                        
                        // Reset both buttons
                        feedbackBtns.forEach(b => {
                            b.classList.remove('active');
                        });
                        
                        // Activate clicked button
                        this.classList.add('active');
                        
                        // Save feedback
                        // In a real app, this would send data to a server
                        console.log(`Wine ID ${wineId} received ${feedback} feedback`);
                    });
                });
            }
            
            function populateRatingHistory() {
                const ratingHistoryContainer = document.getElementById('ratingHistory');
                ratingHistoryContainer.innerHTML = '';
                
                // Combine current ratings with history
                const allRatings = [...ratingHistory, ...currentRatings];
                
                if (allRatings.length === 0) {
                    ratingHistoryContainer.innerHTML = '<p class="text-center text-gray-500 italic">No ratings yet. Start by rating some wine recommendations!</p>';
                    return;
                }
                
                allRatings.forEach(rating => {
                    const ratingCard = document.createElement('div');
                    ratingCard.className = 'bg-white p-4 rounded-lg shadow-sm';
                    
                    // Generate stars HTML
                    let starsHtml = '';
                    for (let i = 1; i <= 5; i++) {
                        const starClass = i <= rating.rating ? 'text-yellow-500' : 'text-gray-300';
                        starsHtml += `<i class="fas fa-star ${starClass}"></i>`;
                    }
                    
                    ratingCard.innerHTML = `
                        <div class="flex justify-between items-start">
                            <div>
                                <h4 class="font-semibold">${rating.name}</h4>
                                <p class="text-sm text-gray-500">${rating.date}</p>
                            </div>
                            <div class="flex">
                                ${starsHtml}
                            </div>
                        </div>
                        <p class="mt-2 text-gray-600">${rating.notes}</p>
                    `;
                    
                    ratingHistoryContainer.appendChild(ratingCard);
                });
            }
            
            function resetQuiz() {
                // Reset quiz options
                document.querySelectorAll('.quiz-option').forEach(option => {
                    option.classList.remove('selected');
                });
                
                // Reset user profile
                userProfile = {
                    meal: '',
                    flavor: '',
                    sweetness: '',
                    dietary: '',
                    budget: ''
                };
                
                // Reset AI processing display
                const statusItems = document.querySelectorAll('#aiStatusUpdates div');
                statusItems.forEach((item, index) => {
                    if (index < 2) {
                        item.querySelector('i').className = 'fas fa-check-circle text-green-500 mr-3';
                        item.querySelector('p').classList.remove('text-gray-400');
                    } else {
                        item.querySelector('i').className = 'fas fa-circle mr-3';
                        item.querySelector('p').classList.add('text-gray-400');
                    }
                });
            }
            
            // Navigation dot click handlers
            navDots.forEach(dot => {
                dot.addEventListener('click', function() {
                    const sectionNumber = parseInt(this.dataset.section);
                    showSection(sectionNumber);
                });
            });
