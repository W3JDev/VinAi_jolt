<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VinAI Match - AI-Powered Wine Pairing System</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/animate.css@4.1.1/animate.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #722F37;
            --secondary: #A67C52;
            --light: #F5F0E6;
            --dark: #1E1A19;
            --accent: #D4AF37;
        }
        
        body {
            font-family: 'Raleway', sans-serif;
            background-color: var(--light);
            color: var(--dark);
            min-height: 100vh;
        }
        
        h1, h2, h3, h4, h5, h6 {
            font-family: 'Playfair Display', serif;
        }
        
        .btn-primary {
            background-color: var(--primary);
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 0.375rem;
            font-weight: 500;
            transition: all 0.3s ease;
        }
        
        .btn-primary:hover {
            background-color: #5c252c;
            transform: translateY(-2px);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .btn-secondary {
            background-color: var(--secondary);
            color: white;
            padding: 0.75rem 1.5rem;
            border-radius: 0.375rem;
            font-weight: 500;
            transition: all 0.3s ease;
        }
        
        .btn-secondary:hover {
            background-color: #8c6845;
            transform: translateY(-2px);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .card {
            background-color: white;
            border-radius: 0.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
        }
        
        .card:hover {
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
            transform: translateY(-5px);
        }
        
        .wine-card {
            border-left: 4px solid var(--primary);
            background-color: white;
            transition: all 0.3s ease;
        }
        
        .wine-card:hover {
            box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
        }
        
        .wine-red {
            border-left-color: #722F37;
        }
        
        .wine-white {
            border-left-color: #D4AF37;
        }
        
        .wine-rose {
            border-left-color: #E8A79B;
        }
        
        .wine-sparkling {
            border-left-color: #BDC3C7;
        }
        
        .quiz-option {
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.2s ease;
        }
        
        .quiz-option:hover {
            border-color: var(--secondary);
        }
        
        .quiz-option.selected {
            border-color: var(--primary);
            background-color: rgba(114, 47, 55, 0.1);
        }
        
        .progress-bar {
            height: 4px;
            background-color: var(--secondary);
            transition: width 0.5s ease;
        }
        
        .rating-star {
            color: #D4AF37;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        
        .rating-star:hover {
            transform: scale(1.2);
        }
        
        .section {
            opacity: 0;
            transition: all 0.5s ease;
            display: none;
            transform: translateY(20px);
        }
        
        .section.active {
            opacity: 1;
            display: block;
            transform: translateY(0);
        }
        
        .wine-badge {
            background-color: var(--primary);
            color: white;
            padding: 0.25rem 0.5rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
        }
        
        .wine-region {
            color: var(--secondary);
            font-weight: 600;
        }
        
        .nav-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background-color: #ccc;
            margin: 0 5px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .nav-dot.active {
            background-color: var(--primary);
            transform: scale(1.2);
        }
        
        .feedback-btn {
            cursor: pointer;
            transition: all 0.2s ease;
        }
        
        .feedback-btn:hover {
            transform: scale(1.1);
        }
        
        .feedback-btn.active {
            color: var(--primary);
        }
        
        .app-container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .gradient-bg {
            background: linear-gradient(135deg, var(--light) 0%, white 100%);
        }

        .pulsate {
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% {
                opacity: 1;
            }
            50% {
                opacity: 0.6;
            }
            100% {
                opacity: 1;
            }
        }
    </style>
</head>
<body>
    <div class="app-container px-4 py-8 md:px-8 lg:px-12">
        <!-- Header -->
        <header class="mb-8 text-center">
            <div class="flex items-center justify-center mb-2">
                <i class="fas fa-wine-glass-alt text-4xl text-primary mr-3" style="color: var(--primary);"></i>
                <h1 class="text-4xl md:text-5xl font-bold text-primary" style="color: var(--primary);">VinAI Match</h1>
            </div>
            <p class="text-lg md:text-xl text-gray-600 italic">Elevate your dining experience with AI-powered wine pairings</p>
        </header>
        
        <!-- Progress Bar -->
        <div class="w-full mb-8 bg-gray-200 rounded-full h-1">
            <div id="progressBar" class="progress-bar rounded-full" style="width: 10%;"></div>
        </div>
        
        <!-- Navigation Dots -->
        <div class="flex justify-center mb-8">
            <div class="nav-dot active" data-section="1"></div>
            <div class="nav-dot" data-section="2"></div>
            <div class="nav-dot" data-section="3"></div>
            <div class="nav-dot" data-section="4"></div>
            <div class="nav-dot" data-section="5"></div>
        </div>
        
        <!-- Welcome Section -->
        <section id="section1" class="section active mb-12">
            <div class="card p-8 gradient-bg">
                <h2 class="text-3xl font-bold mb-6 text-center">Welcome to VinAI Match</h2>
                <p class="text-lg mb-6 text-center">Discover the perfect wine pairings based on your personal taste preferences and meal selections.</p>
                
                <div class="flex flex-col md:flex-row justify-center gap-8 mb-10">
                    <div class="flex flex-col items-center p-4">
                        <div class="w-16 h-16 flex items-center justify-center rounded-full bg-primary mb-4">
                            <i class="fas fa-list-alt text-2xl text-white"></i>
                        </div>
                        <h3 class="text-xl font-semibold mb-2">Taste Profile Quiz</h3>
                        <p class="text-center text-gray-600">Answer a few simple questions about your flavor preferences</p>
                    </div>
                    
                    <div class="flex flex-col items-center p-4">
                        <div class="w-16 h-16 flex items-center justify-center rounded-full bg-primary mb-4">
                            <i class="fas fa-robot text-2xl text-white"></i>
                        </div>
                        <h3 class="text-xl font-semibold mb-2">AI Recommendations</h3>
                        <p class="text-center text-gray-600">Get personalized wine suggestions based on your unique profile</p>
                    </div>
                    
                    <div class="flex flex-col items-center p-4">
                        <div class="w-16 h-16 flex items-center justify-center rounded-full bg-primary mb-4">
                            <i class="fas fa-star text-2xl text-white"></i>
                        </div>
                        <h3 class="text-xl font-semibold mb-2">Rate & Improve</h3>
                        <p class="text-center text-gray-600">Provide feedback to improve future recommendations</p>
                    </div>
                </div>
                
                <div class="flex justify-center">
                    <button id="startBtn" class="btn-primary flex items-center">
                        <span>Start Your Wine Journey</span>
                        <i class="fas fa-chevron-right ml-2"></i>
                    </button>
                </div>
            </div>
        </section>
        
        <!-- Taste Profile Quiz Section -->
        <section id="section2" class="section mb-12">
            <div class="card p-8 gradient-bg">
                <h2 class="text-3xl font-bold mb-6 text-center">Taste Profile Quiz</h2>
                <p class="text-lg mb-8 text-center">Tell us about your preferences so we can find your perfect wine match.</p>
                
                <div id="quizContainer">
                    <!-- Question 1 -->
                    <div class="quiz-question mb-10">
                        <h3 class="text-xl font-semibold mb-4">What type of meal are you planning?</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="meat">
                                <div class="flex items-center">
                                    <i class="fas fa-drumstick-bite text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Red Meat</h4>
                                        <p class="text-sm text-gray-600">Beef, lamb, or game meat</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="poultry">
                                <div class="flex items-center">
                                    <i class="fas fa-drumstick text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Poultry</h4>
                                        <p class="text-sm text-gray-600">Chicken, turkey, or duck</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="seafood">
                                <div class="flex items-center">
                                    <i class="fas fa-fish text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Seafood</h4>
                                        <p class="text-sm text-gray-600">Fish, shellfish, or crustaceans</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="vegetarian">
                                <div class="flex items-center">
                                    <i class="fas fa-leaf text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Vegetarian</h4>
                                        <p class="text-sm text-gray-600">Plant-based dishes</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Question 2 -->
                    <div class="quiz-question mb-10">
                        <h3 class="text-xl font-semibold mb-4">What flavor profile do you prefer?</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="bold">
                                <div class="flex items-center">
                                    <i class="fas fa-bolt text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Bold & Intense</h4>
                                        <p class="text-sm text-gray-600">Strong, powerful flavors</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="fruity">
                                <div class="flex items-center">
                                    <i class="fas fa-apple-alt text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Fruity & Vibrant</h4>
                                        <p class="text-sm text-gray-600">Bright fruit-forward flavors</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="earthy">
                                <div class="flex items-center">
                                    <i class="fas fa-mountain text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Earthy & Complex</h4>
                                        <p class="text-sm text-gray-600">Subtle nuanced flavors</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="light">
                                <div class="flex items-center">
                                    <i class="fas fa-feather text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Light & Delicate</h4>
                                        <p class="text-sm text-gray-600">Soft, elegant flavors</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Question 3 -->
                    <div class="quiz-question mb-10">
                        <h3 class="text-xl font-semibold mb-4">What is your sweetness preference?</h3>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="dry">
                                <div class="flex items-center">
                                    <i class="fas fa-tint-slash text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Dry</h4>
                                        <p class="text-sm text-gray-600">No sweetness</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="medium">
                                <div class="flex items-center">
                                    <i class="fas fa-balance-scale text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Medium</h4>
                                        <p class="text-sm text-gray-600">Hint of sweetness</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="sweet">
                                <div class="flex items-center">
                                    <i class="fas fa-candy-cane text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Sweet</h4>
                                        <p class="text-sm text-gray-600">Noticeable sweetness</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Question 4 -->
                    <div class="quiz-question mb-10">
                        <h3 class="text-xl font-semibold mb-4">Any dietary preferences or restrictions?</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="none">
                                <div class="flex items-center">
                                    <i class="fas fa-check-circle text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">No Restrictions</h4>
                                        <p class="text-sm text-gray-600">All wine styles are fine</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="organic">
                                <div class="flex items-center">
                                    <i class="fas fa-seedling text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Organic/Biodynamic</h4>
                                        <p class="text-sm text-gray-600">Naturally produced wines</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="lowsulfite">
                                <div class="flex items-center">
                                    <i class="fas fa-allergy text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Low Sulfite</h4>
                                        <p class="text-sm text-gray-600">Minimal preservatives</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="vegan">
                                <div class="flex items-center">
                                    <i class="fas fa-ban text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Vegan</h4>
                                        <p class="text-sm text-gray-600">No animal products in processing</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Question 5 -->
                    <div class="quiz-question mb-10">
                        <h3 class="text-xl font-semibold mb-4">What's your budget range?</h3>
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="budget">
                                <div class="flex items-center">
                                    <i class="fas fa-dollar-sign text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Budget</h4>
                                        <p class="text-sm text-gray-600">Under $15</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="moderate">
                                <div class="flex items-center">
                                    <i class="fas fa-dollar-sign text-xl mr-1" style="color: var(--secondary);"></i>
                                    <i class="fas fa-dollar-sign text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Moderate</h4>
                                        <p class="text-sm text-gray-600">$15-$30</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="premium">
                                <div class="flex items-center">
                                    <i class="fas fa-dollar-sign text-xl mr-1" style="color: var(--secondary);"></i>
                                    <i class="fas fa-dollar-sign text-xl mr-1" style="color: var(--secondary);"></i>
                                    <i class="fas fa-dollar-sign text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Premium</h4>
                                        <p class="text-sm text-gray-600">$30-$50</p>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="quiz-option p-4 rounded-lg shadow-sm" data-value="luxury">
                                <div class="flex items-center">
                                    <i class="fas fa-dollar-sign text-xl mr-1" style="color: var(--secondary);"></i>
                                    <i class="fas fa-dollar-sign text-xl mr-1" style="color: var(--secondary);"></i>
                                    <i class="fas fa-dollar-sign text-xl mr-1" style="color: var(--secondary);"></i>
                                    <i class="fas fa-dollar-sign text-xl mr-3" style="color: var(--secondary);"></i>
                                    <div>
                                        <h4 class="font-semibold">Luxury</h4>
                                        <p class="text-sm text-gray-600">$50+</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="flex justify-center mt-8">
                    <button id="findWinesBtn" class="btn-primary flex items-center">
                        <span>Find My Perfect Wines</span>
                        <i class="fas fa-wine-bottle ml-2"></i>
                    </button>
                </div>
            </div>
        </section>
        
        <!-- AI Processing Section -->
        <section id="section3" class="section mb-12">
            <div class="card p-8 gradient-bg text-center">
                <h2 class="text-3xl font-bold mb-6">Analyzing Your Taste Profile</h2>
                <p class="text-lg mb-8">Our AI is working to find your perfect wine pairings...</p>
                
                <div class="flex justify-center mb-8">
                    <div class="w-24 h-24 flex items-center justify-center rounded-full bg-primary pulsate">
                        <i class="fas fa-wine-glass-alt text-3xl text-white"></i>
                    </div>
                </div>
                
                <div class="max-w-md mx-auto mb-8 bg-white rounded-lg p-4 shadow-sm">
                    <div id="aiStatusUpdates" class="text-left">
                        <div class="flex items-center mb-3">
                            <i class="fas fa-check-circle text-green-500 mr-3"></i>
                            <p>Analyzing taste preferences...</p>
                        </div>
                        <div class="flex items-center mb-3">
                            <i class="fas fa-check-circle text-green-500 mr-3"></i>
                            <p>Matching with wine database...</p>
                        </div>
                        <div class="flex items-center mb-3">
                            <i class="fas fa-spinner fa-spin text-primary mr-3"></i>
                            <p>Considering regional specialties...</p>
                        </div>
                        <div class="flex items-center mb-3 text-gray-400">
                            <i class="fas fa-circle mr-3"></i>
                            <p>Evaluating price-quality ratio...</p>
                        </div>
                        <div class="flex items-center text-gray-400">
                            <i class="fas fa-circle mr-3"></i>
                            <p>Finalizing recommendations...</p>
                        </div>
                    </div>
                </div>
                
                <p class="text-sm text-gray-500 italic">This usually takes just a few moments</p>
            </div>
        </section>
        
        <!-- Wine Recommendations Section -->
        <section id="section4" class="section mb-12">
            <div class="card p-8 gradient-bg">
                <h2 class="text-3xl font-bold mb-2 text-center">Your Perfect Wine Matches</h2>
                <p class="text-lg mb-8 text-center">Based on your taste profile, here are your personalized recommendations</p>
                
                <div id="wineRecommendations" class="space-y-6">
                    <!-- Wine cards will be dynamically added here -->
                </div>
                
                <div class="flex justify-center mt-8">
                    <button id="saveRatingsBtn" class="btn-secondary flex items-center">
                        <span>Save My Preferences</span>
                        <i class="fas fa-save ml-2"></i>
                    </button>
                </div>
            </div>
        </section>
        
        <!-- Rating History Section -->
        <section id="section5" class="section mb-12">
            <div class="card p-8 gradient-bg">
                <h2 class="text-3xl font-bold mb-2 text-center">Your Wine Journey</h2>
                <p class="text-lg mb-8 text-center">Track your wine preferences and discover new favorites</p>
                
                <div class="mb-8">
                    <h3 class="text-xl font-semibold mb-4">Your Taste Profile</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="bg-white p-4 rounded-lg shadow-sm">
                            <h4 class="font-semibold mb-2 flex items-center">
                                <i class="fas fa-heart text-primary mr-2"></i>
                                Preferred Wine Types
                            </h4>
                            <div id="preferredWineTypes">
                                <span class="wine-badge mr-2 mb-2 inline-block">Red Blends</span>
                                <span class="wine-badge mr-2 mb-2 inline-block">Pinot Noir</span>
                                <span class="wine-badge mr-2 mb-2 inline-block">Chardonnay</span>
                            </div>
                        </div>
                        
                        <div class="bg-white p-4 rounded-lg shadow-sm">
                            <h4 class="font-semibold mb-2 flex items-center">
                                <i class="fas fa-map-marker-alt text-primary mr-2"></i>
                                Favorite Regions
                            </h4>
                            <div id="favoriteRegions">
                                <span class="wine-badge mr-2 mb-2 inline-block">Tuscany</span>
                                <span class="wine-badge mr-2 mb-2 inline-block">Napa Valley</span>
                                <span class="wine-badge mr-2 mb-2 inline-block">Burgundy</span>
                            </div>
                        </div>
                        
                        <div class="bg-white p-4 rounded-lg shadow-sm">
                            <h4 class="font-semibold mb-2 flex items-center">
